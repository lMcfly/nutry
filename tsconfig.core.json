{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    // Cœur pur : ni DOM, ni types Node, ni globals Vite (ADR 0001).
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/domain", "src/application"],
  // Tests et doublures : typés à part (tsconfig.core-tests.json), jamais dans le cœur livré.
  "exclude": ["src/**/*.test.ts", "src/**/testing/**"]
}
